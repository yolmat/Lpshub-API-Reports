PORT=3000
NODE_ENV=development

# Lista separada por vírgulas, sem caminhos. Ex.: http://localhost:3000,https://app.exemplo.com
# Sem origens configuradas, nenhuma origem externa recebe cabeçalhos CORS.
CORS_ALLOWED_ORIGINS=
# Número de proxies reversos confiáveis. Em produção, defina quando o HTTPS terminar no proxy.
TRUST_PROXY=0
# Reservado para a assinatura JWT da autenticação. Nunca use um valor real neste arquivo.
JWT_SECRET=
# Senha temporária usada na redefinição por administrador. Nunca use um valor real neste arquivo.
PASSWORD_RESET_DEFAULT=
# Credenciais usadas somente pelo script npm run fullTest. Nunca use valores reais neste arquivo.
FULL_TEST_ADMIN_LOGIN=
FULL_TEST_ADMIN_EMAIL=
FULL_TEST_ADMIN_PASSWORD=

DATABASE_URL="postgresql://usuario:senha@localhost:5432/database"

SAP_SERVICE_LAYER_URL="https://seu-servidor-sap:50000"
SAP_SERVICE_LAYER_COMPANY_DB="SUA_EMPRESA"
SAP_SERVICE_LAYER_USERNAME="seu_usuario"
SAP_SERVICE_LAYER_PASSWORD="sua_senha"
SAP_SERVICE_LAYER_TIMEOUT_MS=30000
